version      = 1
exec         = ./dev.sh exec
verify       = pnpm verify
main         = chore/repo/overload-trial
branch       = <type>/<scope>/<description>
types        = feature, fix, hotfix, refactor, test, docs, chore
commit       = [<scope>] <type>: <summary>
commit_types = feat, fix, refactor, perf, test, docs, build, ci, chore
subject_max  = 72
integrate    = merge
rules        = CLAUDE.md, packages/*/CLAUDE.md, docs/adr/
backlog      = docs/backlog.md
specs        = docs/specs
test_files   = bash scripts/test-files.sh {files}
tests_glob   = packages/*/__tests__/**
red_types    = AssertionError, NotImplemented
reference    = .workflow/reference
probe_env    = docker run --rm node:24-bookworm
