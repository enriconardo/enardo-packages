{
  "name": "@enardo/database",
  "version": "2.0.0",
  "description": "The contract of a database connection's lifecycle.",
  "author": "Enrico Nardo <hello@enriconardo.com>",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.enriconardo.com/"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@enardo/eslint-config": "workspace:^",
    "@enardo/typescript-config": "workspace:^",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
