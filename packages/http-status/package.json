{
  "name": "@enardo/http-status",
  "version": "1.0.0",
  "description": "Shared HTTP status constants and type guards",
  "author": "Enrico Nardo <hello@enriconardo.com>",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.enriconardo.com/"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "lint": "eslint src __tests__",
    "lint:fix": "eslint src __tests__ --fix",
    "format": "prettier --write src __tests__",
    "format:check": "prettier --check src __tests__",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@enardo/eslint-config": "workspace:^",
    "@enardo/typescript-config": "workspace:^",
    "@enardo/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
