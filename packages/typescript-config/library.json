{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "declaration": true,
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}",
    "paths": {
      "~/*": ["${configDir}/src/*"]
    }
  },
  "include": ["${configDir}/src/**/*", "${configDir}/__tests__/**/*"],
  "exclude": ["${configDir}/node_modules", "${configDir}/dist"]
}
