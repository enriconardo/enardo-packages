{
  "name": "enardo-packages",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "scripts": {
    "lint:sh": "git ls-files '*.sh' .githooks | xargs -r shellcheck",
    "lint:playwright": "bash docker/playwright/check-version.sh",
    "verify": "pnpm lint:sh && pnpm lint:playwright && turbo run format:check lint typecheck test --filter=...[main]",
    "verify:all": "pnpm lint:sh && pnpm lint:playwright && turbo run format:check lint typecheck test",
    "packages:build": "turbo run build --filter=\"./packages/*\""
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
