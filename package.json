{
  "name": "enardo-packages",
  "version": "1.0.0",
  "private": true,
  "author": "Enrico Nardo <hello@enriconardo.com>",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "scripts": {
    "lint:sh": "git ls-files '*.sh' .githooks | xargs -r shellcheck",
    "lint:playwright": "bash docker/playwright/check-version.sh",
    "lint:context": "bash scripts/check-context-size.sh",
    "verify": "pnpm lint:sh && pnpm lint:playwright && pnpm lint:context && turbo run format:check lint typecheck test --filter=...[main]",
    "verify:all": "pnpm lint:sh && pnpm lint:playwright && pnpm lint:context && turbo run format:check lint typecheck test",
    "packages:build": "turbo run build --filter=\"./packages/*\""
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
